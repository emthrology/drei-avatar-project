{
  "name": "drei-avatar-project",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/extractParts.mjs && node scripts/renderThumbs.mjs",
    "extract": "node scripts/extractParts.mjs",
    "thumbs": "node scripts/renderThumbs.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "probe": "node scripts/probeMotion.mjs",
    "probe:tab": "node scripts/probeAttach.mjs",
    "motion:stat": "vitest run src/companion/anim/motionProfile.test.ts --disable-console-intercept",
    "verify": "vitest run && npm run probe -- --wave --char male1 && npm run probe -- --wave --char female1 && npm run probe -- --clap --char male1 && npm run probe -- --clap --char female1"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.3",
    "@pixiv/three-vrm-animation": "^3.5.3",
    "@react-three/drei": "^9.119.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "postcss": "^8.4.49",
    "prettier": "3.9.6",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.9"
  }
}
